{
  "name": "agent-langgraph-typescript",
  "version": "1.0.0",
  "description": "Simple LangGraph TypeScript application with two sequential agents",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "build:ui": "npx esbuild src/cli.tsx --bundle --platform=node --format=esm --outfile=dist/cli.mjs '--external:@langchain/*' --external:yoga-layout --external:ink --external:react",
    "ui": "node dist/cli.mjs",
    "dev": "npx @langchain/langgraph-cli dev",
    "test": "vitest run",
    "eval": "tsx src/run-evaluation.ts"
  },
  "bin": {
    "research-cli": "./dist/cli.js"
  },
  "bin": {
    "research-cli": "./dist/cli.js"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.26.2",
    "@langchain/community": "^1.1.19",
    "@langchain/core": "^1.1.27",
    "@langchain/langgraph": "^1.1.5",
    "@langchain/langgraph-sdk": "^1.6.5",
    "@langchain/openai": "^1.2.10",
    "@langchain/tavily": "^1.2.0",
    "@types/react": "^19.2.14",
    "apache-arrow": "18.1.0",
    "dotenv": "^17.3.1",
    "ink": "^6.8.0",
    "langchain": "^1.2.26",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.1.14",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.13.0"
}
