# ─────────────────────────────────────────────────────────────
# Agent LangGraph TypeScript — environment variables
# Copy this file to `.env` and fill in your keys.
# ─────────────────────────────────────────────────────────────

# OpenRouter — primary LLM provider (agents + evaluation)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Tavily — web search for the research agent
TAVILY_API_KEY=your_tavily_api_key

# Optional: OpenAI fallback (used when the OpenRouter key is absent)
# OPENAI_API_KEY=

# Optional: LangSmith / LangChain tracing
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_TRACING_V2=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# Optional: OpenCode Go (legacy fallback in getApiKey())
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_API_BASE=https://opencode.ai/zen/go/v1